{
    "name": "secatlas-big4-papers",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "python -m http.server 3000 --directory out",
        "test": "next build && node --test --test-isolation=none tests/rendered-html.test.mjs tests/course-groups.test.mjs",
        "lint": "eslint app db tests next.config.ts drizzle.config.ts eslint.config.mjs postcss.config.mjs --ignore-pattern out --ignore-pattern .next",
        "db:generate": "drizzle-kit generate"
    },
    "dependencies": {
        "drizzle-orm": "0.45.2",
        "next": "16.2.6",
        "react": "19.2.6",
        "react-dom": "19.2.6"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.2.1",
        "@types/node": "22.19.19",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "drizzle-kit": "0.31.10",
        "eslint": "9.39.4",
        "eslint-config-next": "16.2.6",
        "tailwindcss": "4.2.1",
        "typescript": "5.9.3"
    },
    "type": "module",
    "packageManager": "pnpm@11.9.0"
}
